legacy_void rs_gamestep_update_gamestate_impl(legacy_s16 caller_si, legacy_s16 update_audio,
											  legacy_s16 store_checkpoints)
{
	legacy_s8 temple_car_input_730;
	legacy_s32 temple_tmp_731;
	legacy_u16 temple_checkpoint_index_732;
	temple_car_input_730 = TempleCastS8(replay_input_buffer[TempleCastU16(state.game_frame)]);
	if ((TempleCastU32(temple_car_input_730) != 0)) {
		(state.game_inputmode = TempleCastS8(GAME_INPUT_MODE_ACTIVE));
	}
	temple_tmp_731 = !!((checkpoint_frame_interval == 0));
	if (!temple_tmp_731) {
		temple_tmp_731 =
			!!((TempleCastS32(TempleRemainderS64(TempleCastU16(state.game_frame),
												 TempleCastU16(checkpoint_frame_interval))) == 0));
	}
	if (temple_tmp_731) {
		get_kevinrandom_seed(state.kevinseed);
		temple_checkpoint_index_732 = TempleCastU16(
			legacy_u16_div_or_zero(TempleCastU16(TempleCastU16(state.game_frame)),
								   TempleCastU16(TempleCastU16(checkpoint_frame_interval))));
		(caller_si = TempleCastS16(rs_gamestep_legacy_s16_from_bits(
			 TempleCastU16(TempleCastU16(temple_checkpoint_index_732)))));
		if ((store_checkpoints != 0)) {
			__fmemcpy((&(cvxptr[temple_checkpoint_index_732])), (&(state)),
					  TempleCastU16(sizeof(GAMESTATE)));
		}
	}
	(state.game_frame = TempleCastS16(rs_gamestep_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
		 TempleCastU16(TempleCastS32((TempleCastU16(state.game_frame) + TempleCastU16(1)))))))));
	rs_gamestep_update_race_end_timing();
	if ((state.game_inputmode != GAME_INPUT_MODE_WAITING)) {
		update_player_tick_with_legacy_si(TempleCastS8(temple_car_input_730),
										  TempleCastS16(caller_si));
		if ((gameconfig.game_opponenttype != 0)) {
			update_opponent_tick();
		}
		update_follow_cameras();
		if ((state.game_particles_active != 0)) {
			update_crash_particles();
		}
		if ((update_audio != 0)) {
			audio_carstate();
		}
	} else {
		if ((game_replay_mode == REPLAY_MODE_PAUSED)) {
			if ((update_audio != 0)) {
				audio_carstate();
			}
			rs_gamestep_update_race_start_sequence();
		}
	}
}

