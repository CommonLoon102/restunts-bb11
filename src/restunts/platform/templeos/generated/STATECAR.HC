	} else {
		if ((TempleCastU16(rs_statecar_legacy_s16_from_bits(TempleCastU16(
				 TempleCastU16(TempleCastU16(TempleCastU32((0 - TempleCastU16(speed_delta)))))))) >
			 updated_speed)) {
