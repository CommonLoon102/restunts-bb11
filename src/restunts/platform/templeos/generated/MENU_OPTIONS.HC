			TempleCastS16(DIALOG_TYPE_MENU), TempleCastS16(DIALOG_SAVE_BACKGROUND),
			locate_text_res(miscptr, "mid"), TempleCastU16(65535), TempleCastU16(65535),
			TempleCastS16(performGraphColor), 0, TempleCastS16(temple_initial_input_2252))))));
	if ((temple_selected_2253 == 0)) {
		select_keyboard_driving();
	} else {
		if ((temple_selected_2253 == 1)) {
			calibrate_joystick_driving();
		} else {
			if ((temple_selected_2253 == 2)) {
				select_mouse_driving();
			}
		}
	}
}

legacy_u16 run_option_menu()
{
	legacy_s8 temple_title_text_2254[17];
	legacy_s8 temple_version_text_2255[30];
	legacy_u16 temple_i_2257;
	legacy_char *temple_tmp_2258;
	legacy_u16 *temple_tmp_2259;
	legacy_u16 temple_tmp_2260;
	legacy_s8 *temple_prompt_2261;
	legacy_u8 temple_menu_active_2262;
	legacy_s8 temple_selected_2264;
	(miscptr = file_load_resfile("misc"));
	sprite_select_screen_compat();
	sprite_clear_target(TempleCastU8(TempleCastU8(graphics_menu_background_color)));
	MemSet(&temple_title_text_2254, 0, sizeof(temple_title_text_2254));
	MemCpy(temple_title_text_2254, "Chocolate Stunts", 17);
	intro_draw_text(temple_title_text_2254,
					TempleCastS16(font_centered_text_x(temple_title_text_2254)), TempleCastS16(6),
					TempleCastS16(dialog_fnt_colour), TempleCastS16(0));
	MemSet(&temple_version_text_2255, 0, sizeof(temple_version_text_2255));
	MemCpy(temple_version_text_2255, "Version 0000000 (Oct 03 2026)", 30);
	temple_i_2257 = TempleCastU16(0);
	while (1) {
		if (!((temple_i_2257 < 7))) {
			break;
		}
		temple_tmp_2258 = "TempleOS";
		(temple_version_text_2255[((9 - 1) + temple_i_2257)] =
			 TempleCastS8(temple_tmp_2258[temple_i_2257]));
		temple_tmp_2259 = &(temple_i_2257);
		temple_tmp_2260 = *temple_tmp_2259;
		*temple_tmp_2259 = TempleCastU16((temple_tmp_2260 + 1));
		temple_tmp_2260;
	}
	intro_draw_text(temple_version_text_2255,
					TempleCastS16(font_centered_text_x(temple_version_text_2255)),
					TempleCastS16(16), TempleCastS16(dialog_fnt_colour), TempleCastS16(0));
	temple_menu_active_2262 = TempleCastU8(1);
	while (1) {
		if (!((temple_menu_active_2262 != 0))) {
			break;
		}
		temple_selected_2264 =
			TempleCastS8(rs_menu_options_legacy_s8_from_bits(TempleCastU8(TempleCastU8(show_dialog(
				TempleCastS16(DIALOG_TYPE_MENU), TempleCastS16(DIALOG_SAVE_BACKGROUND),
				locate_text_res(miscptr, "mop"), TempleCastU16(65535), TempleCastU16(65535),
				TempleCastS16(dialog_border_color), 0, TempleCastS16(0))))));
		switch (temple_selected_2264) {
			case -1:
			case 6:
				(temple_menu_active_2262 = TempleCastU8(0));
				break;
			case 0:
				rs_menu_options_option_menu_select_input();
				break;
			case 1:
				toggle_music_with_dialog();
				break;
			case 2:
				toggle_effects_with_dialog();
				break;
			case 3:
				(temple_prompt_2261 = locate_text_res(mainresptr, "rep"));
				if ((do_fileselect_dialog(replay_directory, replay_filename_input, ".rpl",
										  temple_prompt_2261) != 0)) {
					(waitflag = TempleCastS16(150));
					show_waiting();
					file_load_replay(replay_directory, replay_filename_input);
					(temple_menu_active_2262 = TempleCastU8(1));
					unload_resource(miscptr);
					return TempleCastU16(temple_menu_active_2262);
				}
				break;
			case 4:
				show_graphic_levels_menu();
				break;
			case 5:
				show_exit_to_dos_dialog();
				break;
		}
	}
	unload_resource(miscptr);
	return TempleCastU16(temple_menu_active_2262);
}
