legacy_void generate_poly_edges(legacy_s16 *edges, legacy_u16 *line_setup, legacy_s16 clipping_mode)
{
	legacy_s16 temple_clip_left_3672;
	legacy_s16 temple_clip_right_3673;
	legacy_s16 temple_step_count_3674;
	legacy_s16 temple_row_index_3675;
	temple_clip_left_3672 = TempleCastS16(drawing_sprite.sprite_raster_left);
	temple_clip_right_3673 = TempleCastS16(drawing_sprite.sprite_raster_right);
	if ((clipping_mode != PRERENDER_EDGE_UNCLIPPED_MODE)) {
		rs_shape3d_prerender_generate_poly_edge_padding(
			edges, line_setup, TempleCastU16(DRAW_LINE_START_LEFT_CLIP_COUNT_INDEX),
			TempleCastS16(temple_clip_left_3672), TempleCastS16(1));
		rs_shape3d_prerender_generate_poly_edge_padding(
			edges, line_setup, TempleCastU16(DRAW_LINE_START_RIGHT_CLIP_COUNT_INDEX),
			TempleCastS16(temple_clip_right_3673), TempleCastS16(1));
		rs_shape3d_prerender_generate_poly_edge_padding(
			edges, line_setup, TempleCastU16(DRAW_LINE_END_LEFT_CLIP_COUNT_INDEX),
			TempleCastS16(temple_clip_left_3672), TempleCastS16(0));
		rs_shape3d_prerender_generate_poly_edge_padding(
			edges, line_setup, TempleCastU16(DRAW_LINE_END_RIGHT_CLIP_COUNT_INDEX),
			TempleCastS16(temple_clip_right_3673), TempleCastS16(0));
	}
	temple_step_count_3674 = TempleCastS16(rs_shape3d_prerender_legacy_s16_from_bits(
		TempleCastU16(TempleCastU16(line_setup[DRAW_LINE_PIXEL_COUNT_INDEX]))));
	if ((temple_step_count_3674 <= 0)) {
		return;
	}
	temple_row_index_3675 = TempleCastS16(rs_shape3d_prerender_legacy_s16_from_bits(
		TempleCastU16(TempleCastU16(line_setup[DRAW_LINE_START_Y_INDEX]))));
	switch (TempleCastU8(line_setup[DRAW_LINE_MODE_AND_CLIP_INDEX])) {
		case 0:
		case 1:
			return;
		case 2:
			rs_shape3d_prerender_generate_poly_vertical(edges, line_setup,
														TempleCastS16(temple_step_count_3674),
														TempleCastS16(temple_row_index_3675));
			return;
		case 3:
			rs_shape3d_prerender_generate_poly_diagonal_left(edges, line_setup,
															 TempleCastS16(temple_step_count_3674),
															 TempleCastS16(temple_row_index_3675));
			return;
		case 4:
			rs_shape3d_prerender_generate_poly_diagonal_right(edges, line_setup,
															  TempleCastS16(temple_step_count_3674),
															  TempleCastS16(temple_row_index_3675));
			return;
		case 5:
		case 6:
			rs_shape3d_prerender_generate_poly_y_major(edges, line_setup,
													   TempleCastS16(temple_step_count_3674),
													   TempleCastS16(temple_row_index_3675));
			return;
		case 7:
			rs_shape3d_prerender_generate_poly_x_major_left(edges, line_setup,
															TempleCastS16(temple_step_count_3674),
															TempleCastS16(temple_row_index_3675));
			return;
		case 8:
			rs_shape3d_prerender_generate_poly_x_major_right(edges, line_setup,
															 TempleCastS16(temple_step_count_3674),
															 TempleCastS16(temple_row_index_3675));
			return;
		case 9:
		default:
			return;
	}
}

legacy_void rs_shape3d_prerender_prerender_extend_edge(legacy_s16 *left_edges,
													   legacy_s16 *right_edges, legacy_s16 index,
													   legacy_s16 value, legacy_s16 to_left)
{
	if (to_left) {
		if ((left_edges[index] > value)) {
			(left_edges[index] = TempleCastS16(value));
		}
	} else {
		if ((right_edges[index] < value)) {
			(right_edges[index] = TempleCastS16(value));
		}
	}
}

