legacy_void RsAudioFadeOut(legacy_s16 delay_ticks)
{
  legacy_u32 noreg temple_delay_2906;
  legacy_u8 noreg temple_uses_direct_channels_2907;
  legacy_s16 noreg temple_volume_2908;
  legacy_u32 noreg temple_tmp_2909;
