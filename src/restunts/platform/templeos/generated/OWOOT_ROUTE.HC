legacy_s16 rs_owoot_route_route_fraction(legacy_s32 numerator, legacy_s32 denominator)
{
	legacy_s16 temple_fraction_7252;
	legacy_u16 temple_bit_7254;
	legacy_s32 *temple_tmp_7255;
	legacy_s16 *temple_tmp_7256;
