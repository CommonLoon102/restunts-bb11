  RsStateplyResolveWheelContacts(carstate,(&(temple_motion_6174)),TempleCastS16(car_index));
  RsStateplyApplyWheelSuspension(carstate,(&(temple_motion_6174)));
  RsStateplyDeriveCarPoseFromWheels((&(temple_motion_6174)));
  RsStateplySumFrontAndRearWheelSurfaces(carstate);
  if((rs_stateply_player_motion_state->game_inputmode!=GAME_INPUT_MODE_INTRO)) {
    RsStateplyPlayCarImpactSounds(carstate,TempleCastS16(car_index));
    RsStateplyCheckCarBodyPlanes(carstate,simd,TempleCastS16(car_index));
    RsStateplyUpdateCarSurfaceContact(carstate,TempleCastS16(car_index));
    RsStateplyPrepareCarCollisionPose(temple_car_pose_6175);
    temple_tmp_6176=!!(RsStateplyHandleOtherCarCollision(carstate,simd,other_carstate,
        other_simd,temple_car_pose_6175,TempleCastS16(car_index)));
