	legacy_u32 temple_tmp_5335;
	legacy_u32 temple_tmp_5336;
	legacy_u32 temple_tmp_5337;
	legacy_s32 temple_tmp_5338;
	legacy_s32 temple_tmp_5339;
	MemCpy(&(rect_ingame_text), &(empty_rect), sizeof(RECTANGLE));
	temple_fps_characters_5331 = TempleCastU16(rs_frame_overlay_prepare_fps_text());
	if ((idle_expired != 0)) {
		rs_frame_overlay_draw_centered_ingame_resource("dm1", TempleCastS16(170));
		rs_frame_overlay_draw_centered_ingame_resource("dm2", TempleCastS16(182));
		return (&(rect_ingame_text));
	}
	if ((game_replay_mode != REPLAY_MODE_LIVE)) {
		temple_replay_y_5332 = TempleCastS16(15);
		if ((replay_filename[0] != 0)) {
			(temple_replay_y_5332 = TempleCastS16(
				 rs_frame_overlay_draw_replay_filename(TempleCastU16(temple_fps_characters_5331))));
		}
		if ((game_replay_mode != REPLAY_MODE_PLAYBACK)) {
			return (&(rect_ingame_text));
		}
		temple_replay_frame_5333 = TempleCastU16(
			TempleCastS32(TempleRemainderS64(TempleCastU16(state.game_frame), framespersec)));
		if ((TempleCastU32((TempleCastU16(1) & 31)) == 0)) {
			temple_tmp_5337 = TempleCastU32(TempleCastU16(framespersec));
		} else {
			if ((TempleCastU32((TempleCastU16(framespersec) & 32768)) != 0)) {
				if ((TempleCastU32((TempleCastU16(1) & 31)) >= 16)) {
					temple_tmp_5334 = TempleCastU32(TempleCastU32(65535));
				} else {
					temple_tmp_5334 = TempleCastU32(TempleCastU32(
						(TempleCastU32(TempleCastS32((TempleCastU16(framespersec) >>
													  TempleCastU32((TempleCastU16(1) & 31))))) |
						 TempleCastU16(TempleCastU32(
							 (TempleCastU32(65535)
							  << TempleCastU32((16 - TempleCastU32((TempleCastU16(1) & 31))))))))));
				}
				temple_tmp_5336 = TempleCastU32(temple_tmp_5334);
			} else {
				if ((TempleCastU32((TempleCastU16(1) & 31)) >= 16)) {
					temple_tmp_5335 = TempleCastU32(0);
				} else {
					temple_tmp_5335 = TempleCastU32(TempleCastU32(TempleCastS32(
						(TempleCastU16(framespersec) >> TempleCastU32((TempleCastU16(1) & 31))))));
				}
				temple_tmp_5336 = TempleCastU32(temple_tmp_5335);
			}
			temple_tmp_5337 = TempleCastU32(temple_tmp_5336);
		}
		if ((temple_replay_frame_5333 >=
			 TempleCastU16(rs_frame_overlay_legacy_s16_from_bits(
				 TempleCastU16(TempleCastU16(TempleCastU16(temple_tmp_5337))))))) {
			return (&(rect_ingame_text));
		}
		copy_string((&(resID_buffer[0])), locate_text_res(gameresptr, "rpl"));
		rs_frame_overlay_draw_replay_text((&(resID_buffer[0])),
										  TempleCastS16(temple_replay_y_5332));
		return (&(rect_ingame_text));
	}
	if ((state.game_inputmode == GAME_INPUT_MODE_WAITING)) {
		rs_frame_overlay_draw_centered_ingame_resource("pre", TempleCastS16(90));
		return (&(rect_ingame_text));
	}
	if ((passed_security == 0)) {
		rs_frame_overlay_draw_centered_ingame_resource("se1", TempleCastS16(93));
		rs_frame_overlay_draw_centered_ingame_resource("se2", TempleCastS16(105));
		return (&(rect_ingame_text));
	}
	temple_tmp_5338 = !!((followOpponentFlag != 0));
	if (!temple_tmp_5338) {
		temple_tmp_5338 = !!((cameramode != CAMERA_MODE_COCKPIT));
	}
	temple_tmp_5339 = !!(temple_tmp_5338);
	if (!temple_tmp_5339) {
		temple_tmp_5339 = !!((state.playerstate.car_crashBmpFlag != CRASH_EVENT_NONE));
	}
	if (temple_tmp_5339) {
		return (&(rect_ingame_text));
	}
	rs_frame_overlay_draw_ingame_route_information();
	return (&(rect_ingame_text));
}
