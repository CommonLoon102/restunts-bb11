legacy_void rs_frame_overlay_draw_ingame_route_information()
{
	switch (state.game_player_route_indicator) {
		case 1:
			sprite_putimage_transparent(sdgame2shapes[DIRECTION_ICON_LEFT_SHAPE],
										TempleCastS16(148), TempleCastS16(93));
			rect_union((&(rect_ingame_text)), (&(rect_ingame_text2)), (&(rect_ingame_text)));
			break;
		case 2:
			sprite_putimage_transparent(sdgame2shapes[DIRECTION_ICON_RIGHT_SHAPE],
										TempleCastS16(148), TempleCastS16(93));
			rect_union((&(rect_ingame_text)), (&(rect_ingame_text2)), (&(rect_ingame_text)));
			break;
		case 3:
			rs_frame_overlay_draw_centered_ingame_resource("www", TempleCastS16(93));
			break;
	}
	(resID_buffer[0] = TempleCastS8(0));
	switch (state.game_opponent_route_indicator) {
		case 1:
			sprite_putimage_transparent(sdgame2shapes[DIRECTION_ICON_LEFT_SHAPE], TempleCastS16(68),
										TempleCastS16(113));
			rect_union((&(rect_ingame_text)), (&(rect_ingame_text3)), (&(rect_ingame_text)));
			copy_string((&(resID_buffer[0])), locate_text_res(gameresptr, "opp"));
			break;
		case 2:
			sprite_putimage_transparent(sdgame2shapes[DIRECTION_ICON_RIGHT_SHAPE],
										TempleCastS16(228), TempleCastS16(113));
			rect_union((&(rect_ingame_text)), (&(rect_ingame_text4)), (&(rect_ingame_text)));
			copy_string((&(resID_buffer[0])), locate_text_res(gameresptr, "opp"));
			break;
	}
	if ((resID_buffer[0] != 0)) {
		rect_union((&(rect_ingame_text)),
				   intro_draw_text((&(resID_buffer[0])),
								   TempleCastS16(font_centered_text_x((&(resID_buffer[0])))),
								   TempleCastS16(116), TempleCastS16(dialog_fnt_colour),
								   TempleCastS16(0)),
				   (&(rect_ingame_text)));
	}
	if ((show_penalty_counter != 0)) {
		copy_string((&(resID_buffer[0])), locate_text_res(gameresptr, "pen"));
		format_frame_as_string(((&(resID_buffer[0])) + _strlen((&(resID_buffer[0])))),
							   TempleCastS16(penalty_time), TempleCastS16(0));
		rect_union((&(rect_ingame_text)),
				   intro_draw_text((&(resID_buffer[0])),
								   TempleCastS16(font_centered_text_x((&(resID_buffer[0])))),
								   TempleCastS16(102), TempleCastS16(dialog_fnt_colour),
								   TempleCastS16(0)),
				   (&(rect_ingame_text)));
	}
}

