			 rs_dashboard_dashboard_clear_steering_dot(TempleCastU16(update->buffer_index))));
		shape2d_rle_copy_position_clipped(whlshapes[update->wheel_state]);
		(dashboard_wheel_shape_cache[update->buffer_index] = TempleCastU8(update->wheel_state));
		(update->wheel_redrawn = TempleCastU8(1));
	} else {
		(update->wheel_redrawn = TempleCastU8(0));
	}
}

legacy_void rs_dashboard_dashboard_select_gauges(DASHBOARD_UPDATE *update)
{
	if ((simd_player.spdcenter.py == TempleCastS32((-(1))))) {
		(update->speed_index = TempleCastU16(0));
		(update->gauge_mode = TempleCastU8(DASHBOARD_GAUGE_HIDDEN));
	} else {
		if ((simd_player.spdcenter.py == 0)) {
			(update->speed_index = TempleCastU16(
				 TempleCastS32((TempleCastU16(state.playerstate.car_rev_speed) >> 8))));
			(update->gauge_mode = TempleCastU8(DASHBOARD_GAUGE_DIGITAL));
		} else {
			(update->speed_index = TempleCastU16(legacy_u16_div_or_zero(
				 TempleCastU16(TempleCastU16(state.playerstate.car_rev_speed)),
				 TempleCastU16(TempleCastU16(640)))));
			if ((TempleCastS16(update->speed_index) >= simd_player.spdnumpoints)) {
				(update->speed_index =
					 TempleCastU16(TempleCastU16(TempleCastS32((simd_player.spdnumpoints - 1)))));
			}
			(update->gauge_mode = TempleCastU8(DASHBOARD_GAUGE_ANALOG));
		}
	}
	(update->rpm_index =
		 TempleCastU16(TempleCastS32((TempleCastU16(state.playerstate.car_currpm) >> 7))));
	if ((TempleCastS16(update->rpm_index) >= simd_player.revnumpoints)) {
		(update->rpm_index =
			 TempleCastU16(TempleCastU16(TempleCastS32((simd_player.revnumpoints - 1)))));
	}
}

legacy_void rs_dashboard_dashboard_draw_digital_speed(legacy_u16 speed_index)
{
	legacy_u16 temple_digit_group_2126;
	legacy_u16 *temple_tmp_2127;
	legacy_u16 *temple_tmp_2128;
	legacy_u8 temple_digit_started_2129;
	legacy_u16 temple_digit_2130;
	legacy_s32 temple_tmp_2131;
	legacy_u16 *temple_tmp_2132;
	temple_digit_group_2126 = TempleCastU16(0);
	if ((speed_index >= 200)) {
		(temple_digit_group_2126 = TempleCastU16(2));
		temple_tmp_2127 = &(speed_index);
		((*temple_tmp_2127) = TempleCastU16(((*temple_tmp_2127) - 200)));
	} else {
		if ((speed_index >= 100)) {
			(temple_digit_group_2126 = TempleCastU16(1));
			temple_tmp_2128 = &(speed_index);
			((*temple_tmp_2128) = TempleCastU16(((*temple_tmp_2128) - 100)));
		}
	}
	temple_digit_started_2129 = TempleCastU8(0);
	if ((temple_digit_group_2126 != 0)) {
		sprite_putimage_or(
			digshapes[temple_digit_group_2126],
			TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_HUNDREDS_X])),
			TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_HUNDREDS_Y])));
		(temple_digit_started_2129 = TempleCastU8(1));
	}
	temple_digit_2130 = TempleCastU16(legacy_u16_div_or_zero(
		TempleCastU16(TempleCastU16(speed_index)), TempleCastU16(TempleCastU16(10))));
	temple_tmp_2131 = !!((temple_digit_2130 != 0));
	if (!temple_tmp_2131) {
		temple_tmp_2131 = !!((temple_digit_started_2129 != 0));
	}
	if (temple_tmp_2131) {
		sprite_putimage_or(
			digshapes[temple_digit_2130],
			TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_TENS_X])),
			TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_TENS_Y])));
		temple_tmp_2132 = &(speed_index);
		((*temple_tmp_2132) =
			 TempleCastU16(((*temple_tmp_2132) - TempleCastU32((temple_digit_2130 * 10)))));
	}
	sprite_putimage_or(digshapes[speed_index],
					   TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_UNITS_X])),
					   TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_UNITS_Y])));
}

legacy_void rs_dashboard_dashboard_draw_wheel_mask(legacy_u8 wheel_state)
{
	if ((wheel_state == DASHBOARD_WHEEL_STATE_LEFT)) {
		shape2d_render_bmp_as_mask(whlshapes[DASHBOARD_LEFT_INSTRUMENT_MASK_SHAPE]);
		shape2d_rle_or_far_pointer(TempleCastU16(dos_memory_pointer_offset(
									   whlshapes[DASHBOARD_LEFT_INSTRUMENT_SOURCE_SHAPE])),
								   TempleCastU16(dos_memory_pointer_segment(
									   whlshapes[DASHBOARD_LEFT_INSTRUMENT_SOURCE_SHAPE])));
	} else {
		if ((wheel_state == DASHBOARD_WHEEL_STATE_RIGHT)) {
			shape2d_render_bmp_as_mask(whlshapes[DASHBOARD_RIGHT_INSTRUMENT_MASK_SHAPE]);
			shape2d_rle_or_far_pointer(TempleCastU16(dos_memory_pointer_offset(
										   whlshapes[DASHBOARD_RIGHT_INSTRUMENT_SOURCE_SHAPE])),
									   TempleCastU16(dos_memory_pointer_segment(
										   whlshapes[DASHBOARD_RIGHT_INSTRUMENT_SOURCE_SHAPE])));
		}
	}
}

legacy_void rs_dashboard_dashboard_update_instruments(DASHBOARD_UPDATE *update)
{
	legacy_u16 temple_dot_index_2133;
	legacy_s32 temple_tmp_2134;
	legacy_s32 temple_tmp_2135;
	legacy_s32 temple_tmp_2136;
	legacy_u16 temple_needle_colors_2137;
	legacy_u8 temple_speed_color_2138;
	legacy_u8 temple_rpm_color_2139;
	temple_tmp_2134 = !!((update->wheel_redrawn != 0));
	if (!temple_tmp_2134) {
		temple_tmp_2134 = !!((full_redraw_frames_remaining != 0));
	}
	temple_tmp_2135 = !!(temple_tmp_2134);
	if (!temple_tmp_2135) {
		temple_tmp_2135 = !!((dashboard_speed_index_cache[update->buffer_index] !=
							  TempleCastS16(update->speed_index)));
	}
	temple_tmp_2136 = !!(temple_tmp_2135);
	if (!temple_tmp_2136) {
		temple_tmp_2136 = !!(
			(dashboard_rpm_index_cache[update->buffer_index] != TempleCastS16(update->rpm_index)));
	}
	if (temple_tmp_2136) {
		if ((video_uses_page_flipping == 0)) {
			mouse_draw_opaque_check();
		}
		if ((rs_dashboard_dashboard_clear_steering_dot(TempleCastU16(update->buffer_index)) != 0)) {
			(update->steering_dot_cleared = TempleCastU8(1));
		}
		rs_dashboard_dashboard_select_panel_target(dashboard_instrument_sprite,
												   whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE]);
		shape2d_rle_copy(whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE], TempleCastS16(0),
						 TempleCastS16(0));
		(dashboard_speed_index_cache[update->buffer_index] =
			 TempleCastS16(TempleCastS16(update->speed_index)));
		(dashboard_rpm_index_cache[update->buffer_index] =
			 TempleCastS16(TempleCastS16(update->rpm_index)));
		temple_needle_colors_2137 =
			TempleCastU16(TempleCastU16(simd_player.reserved_handling_words[4]));
		temple_speed_color_2138 = TempleCastU8(TempleCastU8(temple_needle_colors_2137));
		temple_rpm_color_2139 =
			TempleCastU8(TempleCastU8(TempleCastS32((temple_needle_colors_2137 >> 8))));
		if ((temple_rpm_color_2139 == 0)) {
			(temple_rpm_color_2139 = TempleCastU8(temple_speed_color_2138));
		}
		if ((update->gauge_mode == DASHBOARD_GAUGE_DIGITAL)) {
			rs_dashboard_dashboard_draw_digital_speed(TempleCastU16(update->speed_index));
		} else {
			if ((update->gauge_mode == DASHBOARD_GAUGE_ANALOG)) {
				(temple_dot_index_2133 = TempleCastU16(TempleCastU32((update->speed_index * 2))));
				preRender_line(
					TempleCastU16(simd_player.spdcenter.px),
					TempleCastU16(simd_player.spdcenter.py),
					TempleCastU16(TempleCastU8(simd_player.spdpoints[temple_dot_index_2133])),
					TempleCastU16(TempleCastU8(
						simd_player.spdpoints[TempleCastU32((temple_dot_index_2133 + 1))])),
					TempleCastU16(temple_speed_color_2138));
			}
		}
		(temple_dot_index_2133 = TempleCastU16(TempleCastU32((update->rpm_index * 2))));
		preRender_line(TempleCastU16(simd_player.revcenter.px),
					   TempleCastU16(simd_player.revcenter.py),
					   TempleCastU16(TempleCastU8(simd_player.revpoints[temple_dot_index_2133])),
					   TempleCastU16(TempleCastU8(
						   simd_player.revpoints[TempleCastU32((temple_dot_index_2133 + 1))])),
					   TempleCastU16(temple_rpm_color_2139));
		rs_dashboard_dashboard_draw_wheel_mask(TempleCastU8(update->wheel_state));
		if ((video_uses_page_flipping != 0)) {
			sprite_select_mcga_backbuffer();
		} else {
			sprite_select_screen_compat();
		}
		rs_dashboard_dashboard_copy_panel(dashboard_instrument_sprite,
										  whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE]);
	}
}

legacy_void rs_dashboard_dashboard_update_steering_dot(DASHBOARD_UPDATE *update)
{
	legacy_s32 temple_tmp_2140;
	legacy_s32 temple_tmp_2141;
	legacy_u8 *temple_steering_dots_2142;
	legacy_u16 temple_dot_index_2143;
	legacy_s32 temple_tmp_2144;
	legacy_s16 temple_dot_x_2145;
	legacy_s16 temple_dot_y_2146;
	temple_tmp_2140 =
		!!((dashboard_steering_position_cache[update->buffer_index] != update->steering_position));
	if (!temple_tmp_2140) {
		temple_tmp_2140 = !!((full_redraw_frames_remaining != 0));
	}
	temple_tmp_2141 = !!(temple_tmp_2140);
	if (!temple_tmp_2141) {
		temple_tmp_2141 = !!((update->steering_dot_cleared != 0));
	}
	if (temple_tmp_2141) {
		if ((video_uses_page_flipping == 0)) {
			mouse_draw_opaque_check();
		}
		rs_dashboard_dashboard_set_viewport();
		rs_dashboard_dashboard_clear_steering_dot(TempleCastU16(update->buffer_index));
		temple_steering_dots_2142 = (simd_player.steeringdots)(legacy_u8 *);
		if ((update->steering_position < 0)) {
			temple_tmp_2144 = TempleCastS32(
				rs_dashboard_legacy_s16_from_bits(TempleCastU16(TempleCastU16(TempleCastU16(
					TempleCastU32((0 - TempleCastU16(update->steering_position))))))));
		} else {
			temple_tmp_2144 = TempleCastS32(update->steering_position);
		}
		temple_dot_index_2143 = TempleCastU16(TempleCastU32((TempleCastU16(temple_tmp_2144) * 2)));
		temple_dot_x_2145 = TempleCastS16(temple_steering_dots_2142[temple_dot_index_2143]);
		temple_dot_y_2146 =
			TempleCastS16(temple_steering_dots_2142[TempleCastU32((temple_dot_index_2143 + 1))]);
		if ((update->steering_position < 0)) {
			(temple_dot_x_2145 = TempleCastS16(TempleCastU8(TempleCastS32((
				 temple_dot_x_2145 -
				 TempleCastU8(TempleCastS32((
					 TempleCastU8(TempleCastS32((temple_dot_x_2145 - temple_steering_dots_2142[0])))
					 << 1))))))));
		}
		(dashboard_steering_dot_x_cache[update->buffer_index] = TempleCastS16(
			 rs_dashboard_legacy_s16_from_bits(TempleCastU16(TempleCastU16(TempleCastS32(
				 (TempleCastU16(TempleCastS32(
					  (TempleCastU8(temple_dot_x_2145) -
					   shape2d_get_anchor_x(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE])))) &
				  TempleCastU16(video_x_alignment_mask))))))));
		(dashboard_steering_dot_y_cache[update->buffer_index] = TempleCastS16(
			 rs_dashboard_legacy_s16_from_bits(TempleCastU16(TempleCastU16(TempleCastU16(
				 TempleCastS32((TempleCastU16(TempleCastU8(temple_dot_y_2146)) -
								TempleCastU16(shape2d_get_anchor_y(
									gnobshapes[DASHBOARD_STEERING_DOT_SHAPE]))))))))));
		sprite_clear_shape_alt(gnobshapes[TempleCastS32((DASHBOARD_STEERING_DOT_BUFFER_FIRST_SHAPE +
														 TempleCastU8(frame_buffer_index)))],
							   TempleCastS16(dashboard_steering_dot_x_cache[update->buffer_index]),
							   TempleCastS16(dashboard_steering_dot_y_cache[update->buffer_index]));
		sprite_and_image_at_anchor(gnobshapes[DASHBOARD_STEERING_DOT_BACKGROUND_SHAPE],
								   TempleCastS16(temple_dot_x_2145),
								   TempleCastS16(temple_dot_y_2146));
		sprite_or_image_at_anchor(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE],
								  TempleCastS16(temple_dot_x_2145),
								  TempleCastS16(temple_dot_y_2146));
		(dashboard_steering_position_cache[update->buffer_index] =
			 TempleCastS16(update->steering_position));
	}
}

legacy_void rs_dashboard_dashboard_update()
{
	DASHBOARD_UPDATE temple_update_2147;
	(temple_update_2147.buffer_index = TempleCastU16(TempleCastU8(dashboard_buffer_index)));
	(temple_update_2147.steering_dot_cleared = TempleCastU8(0));
	rs_dashboard_dashboard_update_gear(TempleCastU16(temple_update_2147.buffer_index));
	rs_dashboard_dashboard_update_wheel((&(temple_update_2147)));
	rs_dashboard_dashboard_select_gauges((&(temple_update_2147)));
	rs_dashboard_dashboard_update_instruments((&(temple_update_2147)));
	rs_dashboard_dashboard_update_steering_dot((&(temple_update_2147)));
	mouse_draw_transparent_check();
}

legacy_void setup_car_shapes(legacy_s16 operation)
{
	switch (operation) {
		case 0:
			rs_dashboard_dashboard_load();
			break;
		case 1:
			rs_dashboard_dashboard_redraw_static();
			break;
		case 2:
			rs_dashboard_dashboard_update();
			break;
		case 3:
			rs_dashboard_dashboard_unload();
			break;
	}
}
