		rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(TempleCastS32(normal->x)) * TempleCastU32(TempleCastS32(x)))))))));
	temple_y_product_422 = TempleCastS32(
		rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(TempleCastS32(normal->y)) * TempleCastU32(TempleCastS32(y)))))))));
	temple_z_product_423 = TempleCastS32(
		rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(TempleCastS32(normal->z)) * TempleCastU32(TempleCastS32(z)))))))));
	temple_sum_424 =
		TempleCastS32(rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(
				 (TempleCastU32(temple_x_product_421) + TempleCastU32(temple_z_product_423))))))) +
			 TempleCastU32(temple_y_product_422)))))));
	temple_quotient_425 = TempleCastS32(legacy_s32_div_or_zero(
		TempleCastS32(rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(temple_sum_424)))),
		TempleCastS32(rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(8192))))));
	return TempleCastS16(rs_math_legacy_s16_from_bits(
		TempleCastU16(TempleCastU16(TempleCastU16(temple_quotient_425)))));
