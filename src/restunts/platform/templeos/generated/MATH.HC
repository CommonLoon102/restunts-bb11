	legacy_s32 temple_product_417;
	legacy_u32 temple_scaled_bits_418;
	legacy_u16 temple_high_word_419;
	legacy_u16 temple_round_up_420;
	temple_product_417 = TempleCastS32(
		rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(TempleCastS32(left)) * TempleCastU32(TempleCastS32(right)))))))));
	temple_scaled_bits_418 =
		TempleCastU32(TempleCastU32((TempleCastU32(TempleCastU32(temple_product_417))
									 << TempleCastU32((TempleCastU16(2) & 31)))));
	temple_high_word_419 =
		TempleCastU16(TempleCastU16(TempleCastU32((temple_scaled_bits_418 >> 16))));
	temple_round_up_420 = TempleCastU16(TempleCastU16(
		TempleCastU32((TempleCastU32((temple_scaled_bits_418 & TempleCastU32(32768))) >>
					   TempleCastU32((16 - 1))))));
	return TempleCastS16(
		rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
			(TempleCastU16(temple_high_word_419) + TempleCastU16(temple_round_up_420))))))));
}

legacy_s16 vec_normalInnerProduct(legacy_s16 x, legacy_s16 y, legacy_s16 z, VECTOR *normal)
