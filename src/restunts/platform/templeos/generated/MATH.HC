				 (TempleCastU32(temple_angle_404) << TempleCastU32((TempleCastU16(4) & 31)))))))) -
			 TempleCastU32(temple_angle_404))))))));
	if ((TempleCastU32((TempleCastU16(10) & 31)) == 0)) {
		temple_tmp_408 = TempleCastU32(TempleCastU32(temple_scaled_angle_406));
	} else {
		if ((TempleCastU32((TempleCastU32(temple_scaled_angle_406) & TempleCastU32(2147483648))) !=
			 0)) {
			temple_tmp_407 = TempleCastU32(TempleCastU32(
				(TempleCastU32((TempleCastU32(temple_scaled_angle_406) >>
								TempleCastU32((TempleCastU16(10) & 31)))) |
				 TempleCastU32((TempleCastU32(4294967295) << TempleCastU32(
									(32 - TempleCastU32((TempleCastU16(10) & 31)))))))));
		} else {
			temple_tmp_407 =
				TempleCastU32(TempleCastU32((TempleCastU32(temple_scaled_angle_406) >>
											 TempleCastU32((TempleCastU16(10) & 31)))));
		}
		temple_tmp_408 = TempleCastU32(temple_tmp_407);
	}
	(temple_result_403 =
		 TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(TempleCastU16(
			 TempleCastS32((TempleCastU16(temple_result_403) +
							TempleCastU16(TempleCastS16(rs_math_legacy_s32_from_bits(TempleCastU32(
								TempleCastU32(TempleCastU32(temple_tmp_408))))))))))))));
	return TempleCastS16(temple_result_403);
}

legacy_s16 rs_math_saturate_projection(legacy_s32 sum)
{
	if ((sum > TempleCastS32(32767))) {
		return TempleCastS16(32000);
	}
	if ((sum < TempleCastS32((-(TempleCastS32(32768)))))) {
		return TempleCastS16(TempleCastS32((-(32000))));
	}
	return TempleCastS16(TempleCastS16(sum));
}

legacy_u16 rs_math_projection_magnitude(legacy_s16 value)
{
	return TempleCastU16(TempleCastU16(TempleCastU32((0 - TempleCastU16(value)))));
}

legacy_void vector_to_point(VECTOR *vec, POINT2D *outpt)
{
	legacy_s16 temple_comp_409;
	legacy_u32 temple_proj_410;
	if ((vec->z <= 0)) {
		(outpt->px =
			 TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(32768)))));
		(outpt->py =
			 TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(32768)))));
		return;
	}
	if ((vec->x < 0)) {
		(temple_proj_410 = TempleCastU32(
			 TempleCastU32((TempleCastU32(rs_math_projection_magnitude(TempleCastS16(vec->x))) *
							TempleCastU16(projection_focal_length_x)))));
		(temple_comp_409 = TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_410 >> 15)))));
		if ((vec->z > temple_comp_409)) {
			(outpt->px = TempleCastS16(rs_math_saturate_projection(TempleCastS32(
				 TempleCastS32((TempleCastS32((-(TempleCastS32(legacy_u32_div_or_zero(
									TempleCastU32(TempleCastU32(temple_proj_410)),
									TempleCastU32(TempleCastU32(TempleCastU16(vec->z)))))))) +
								TempleCastS16(projection_center_x)))))));
		} else {
			(outpt->px = TempleCastS16(TempleCastS32((-(32000)))));
		}
	} else {
		(temple_proj_410 = TempleCastU32(TempleCastU32(
			 (TempleCastU32(TempleCastU16(vec->x)) * TempleCastU16(projection_focal_length_x)))));
		(temple_comp_409 = TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_410 >> 15)))));
		if ((vec->z > temple_comp_409)) {
			(outpt->px = TempleCastS16(rs_math_saturate_projection(TempleCastS32(
				 TempleCastS32((TempleCastS32(legacy_u32_div_or_zero(
									TempleCastU32(TempleCastU32(temple_proj_410)),
									TempleCastU32(TempleCastU32(TempleCastU16(vec->z))))) +
								TempleCastS16(projection_center_x)))))));
		} else {
			(outpt->px = TempleCastS16(32000));
		}
	}
	if ((vec->y < 0)) {
		(temple_proj_410 = TempleCastU32(
			 TempleCastU32((TempleCastU32(rs_math_projection_magnitude(TempleCastS16(vec->y))) *
							TempleCastU16(projection_focal_length_y)))));
		(temple_comp_409 = TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_410 >> 15)))));
		if ((vec->z > temple_comp_409)) {
			(outpt->py = TempleCastS16(rs_math_saturate_projection(TempleCastS32(
				 TempleCastS32((TempleCastS32(legacy_u32_div_or_zero(
									TempleCastU32(TempleCastU32(temple_proj_410)),
									TempleCastU32(TempleCastU32(TempleCastU16(vec->z))))) +
								TempleCastS16(projection_center_y)))))));
		} else {
			(outpt->py = TempleCastS16(32000));
		}
	} else {
		(temple_proj_410 = TempleCastU32(TempleCastU32(
			 (TempleCastU32(TempleCastU16(vec->y)) * TempleCastU16(projection_focal_length_y)))));
		(temple_comp_409 = TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_410 >> 15)))));
		if ((vec->z > temple_comp_409)) {
			(outpt->py = TempleCastS16(rs_math_saturate_projection(TempleCastS32(
				 TempleCastS32((TempleCastS32((-(TempleCastS32(legacy_u32_div_or_zero(
									TempleCastU32(TempleCastU32(temple_proj_410)),
									TempleCastU32(TempleCastU32(TempleCastU16(vec->z)))))))) +
								TempleCastS16(projection_center_y)))))));
		} else {
			(outpt->py = TempleCastS16(TempleCastS32((-(32000)))));
		}
	}
}

legacy_s16 rs_math_vector_interpolate_axis(legacy_s16 first, legacy_s16 second, legacy_s16 factor,
										   legacy_s16 divisor)
{
	legacy_s32 temple_product_411;
	legacy_s32 temple_quotient_412;
	temple_product_411 = TempleCastS32(
		rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastU32(TempleCastU32(
			(TempleCastU32(TempleCastS32(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
				 TempleCastU16(TempleCastS32((TempleCastU16(first) - TempleCastU16(second))))))))) *
			 TempleCastU32(TempleCastS32(factor)))))))));
	temple_quotient_412 = TempleCastS32(legacy_s32_div_or_zero(
		TempleCastS32(
			rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(temple_product_411)))),
		TempleCastS32(
			rs_math_legacy_s32_from_bits(TempleCastU32(TempleCastU32(TempleCastS32(divisor)))))));
	return TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
		TempleCastU16(TempleCastS32((TempleCastU16(rs_math_legacy_s16_from_bits(TempleCastU16(
										 TempleCastU16(TempleCastU16(temple_quotient_412))))) +
									 TempleCastU16(second))))))));
}

legacy_void vector_interpolate_at_z(VECTOR *first, VECTOR *second, VECTOR *result, legacy_s16 depth)
{
	legacy_s16 temple_depth_offset_413;
	legacy_s16 temple_depth_span_414;
	(result->z = TempleCastS16(depth));
	temple_depth_offset_413 =
		TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
			TempleCastU16(TempleCastS32((TempleCastU16(result->z) - TempleCastU16(second->z))))))));
	temple_depth_span_414 = TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
		TempleCastU16(TempleCastS32((TempleCastU16(first->z) - TempleCastU16(second->z))))))));
	if ((temple_depth_span_414 < 0)) {
		(temple_depth_offset_413 = TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(
			 TempleCastU16(TempleCastS32((TempleCastU16(temple_depth_offset_413) >> 1)))))));
		(temple_depth_span_414 = TempleCastS16(rs_math_legacy_s16_from_bits(TempleCastU16(
			 TempleCastU16(TempleCastS32((TempleCastU16(temple_depth_span_414) >> 1)))))));
	}
	(result->x = TempleCastS16(rs_math_vector_interpolate_axis(
		 TempleCastS16(first->x), TempleCastS16(second->x), TempleCastS16(temple_depth_offset_413),
		 TempleCastS16(temple_depth_span_414))));
	(result->y = TempleCastS16(rs_math_vector_interpolate_axis(
		 TempleCastS16(first->y), TempleCastS16(second->y), TempleCastS16(temple_depth_offset_413),
		 TempleCastS16(temple_depth_span_414))));
}

legacy_void vector_interpolate_at_saved_z(VECTOR *vec1, VECTOR *vec2, VECTOR *outvec)
{
	legacy_u16 temple_interpolation_z_415;
	legacy_u32 temple_tmp_416;
	if ((TempleCastU32((TempleCastU16(8) & 31)) >= 16)) {
		temple_tmp_416 = TempleCastU32(0);
	} else {
		temple_tmp_416 =
			TempleCastU32(TempleCastU32((TempleCastU32(TempleCastU16(vector_saved_z_high))
										 << TempleCastU32((TempleCastU16(8) & 31)))));
	}
	temple_interpolation_z_415 = TempleCastU16(
		TempleCastU16(TempleCastS32((vector_saved_z_low | TempleCastU16(temple_tmp_416)))));
	vector_interpolate_at_z(vec1, vec2, outvec,
							TempleCastS16(rs_math_legacy_s16_from_bits(
								TempleCastU16(TempleCastU16(temple_interpolation_z_415)))));
}

legacy_s16 multiply_and_scale(legacy_s16 left, legacy_s16 right)
