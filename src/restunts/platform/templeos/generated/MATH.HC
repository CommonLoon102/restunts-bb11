legacy_s16 plane_signed_distance(legacy_s16 plane_index, legacy_s16 x, legacy_s16 y, legacy_s16 z)
{
	PLANE *temple_plane_426;
	VECTOR temple_world_origin_427;
	VECTOR temple_relative_position_428;
	if ((plane_index == planindex)) {
		(temple_plane_426 = current_planptr);
	} else {
		(temple_plane_426 = (&(planptr[plane_index])));
	}
	(temple_world_origin_427.y =
		 TempleCastS16(TempleCastS32((temple_plane_426->plane_origin.y + terrainHeight))));
	(temple_relative_position_428.y =
		 TempleCastS16(TempleCastS32((y - temple_world_origin_427.y))));
	if ((plane_index < 4)) {
		return TempleCastS16(temple_relative_position_428.y);
	}
	(temple_world_origin_427.x =
		 TempleCastS16(TempleCastS32((temple_plane_426->plane_origin.x + elem_xCenter))));
	(temple_world_origin_427.z =
		 TempleCastS16(TempleCastS32((temple_plane_426->plane_origin.z + elem_zCenter))));
	(temple_relative_position_428.x =
		 TempleCastS16(TempleCastS32((x - temple_world_origin_427.x))));
	(temple_relative_position_428.z =
		 TempleCastS16(TempleCastS32((z - temple_world_origin_427.z))));
	return TempleCastS16(vec_normalInnerProduct(TempleCastS16(temple_relative_position_428.x),
												TempleCastS16(temple_relative_position_428.y),
												TempleCastS16(temple_relative_position_428.z),
												(&(temple_plane_426->plane_normal))));
}

legacy_void transform_wheel_travel_to_world()
{
	VECTOR temple_world_direction_429;
	PLANE *temple_plane_430;
	VECTOR temple_plane_direction_431;
	MATRIX temple_inverse_plane_rotation_432;
	MATRIX temple_plane_rotation_433;
	legacy_s16 temple_heading_434;
	legacy_s32 temple_tmp_435;
	legacy_s16 *temple_tmp_436;
	if ((planindex_copy != TempleCastS32((-(1))))) {
		(temple_plane_430 = (&(planptr[planindex_copy])));
		temple_tmp_435 = !!((temple_plane_430->plane_xy == car_initial_pitch));
		if (temple_tmp_435) {
			temple_tmp_435 = !!((temple_plane_430->plane_yz == car_initial_roll));
		}
		if (temple_tmp_435) {
			(temple_heading_434 = TempleCastS16(car_initial_yaw));
		} else {
			mat_mul_vector((&(wheel_forward_travel)), (&(car_to_world_rotation)),
						   (&(temple_world_direction_429)));
			MemCpy(&(temple_plane_rotation_433), &(temple_plane_430->plane_rotation),
				   sizeof(MATRIX));
			mat_invert((&(temple_plane_rotation_433)), (&(temple_inverse_plane_rotation_432)));
			mat_mul_vector((&(temple_world_direction_429)), (&(temple_inverse_plane_rotation_432)),
						   (&(temple_plane_direction_431)));
			(temple_heading_434 = TempleCastS16(
				 polarAngle(TempleCastS16(TempleCastS32((-(temple_plane_direction_431.x)))),
							TempleCastS16(temple_plane_direction_431.z))));
		}
		temple_tmp_436 = &(temple_heading_434);
		((*temple_tmp_436) = TempleCastS16(((*temple_tmp_436) + wheel_heading_offset)));
		if ((temple_heading_434 == 0)) {
			mat_mul_vector2((&(wheel_forward_travel)), (&(temple_plane_430->plane_rotation)),
							(&(wheel_world_travel)));
			return;
		}
		if ((cached_plane_heading != temple_heading_434)) {
			mat_rot_y((&(plane_heading_rotation)),
					  TempleCastS16(TempleCastS32((-(temple_heading_434)))));
			(cached_plane_heading = TempleCastS16(temple_heading_434));
		}
		mat_mul_vector((&(wheel_forward_travel)), (&(plane_heading_rotation)),
					   (&(temple_plane_direction_431)));
		mat_mul_vector2((&(temple_plane_direction_431)), (&(temple_plane_430->plane_rotation)),
						(&(wheel_world_travel)));
		return;
	}
	if ((wheel_heading_offset == 0)) {
		mat_mul_vector((&(wheel_forward_travel)), (&(car_to_world_rotation)),
					   (&(wheel_world_travel)));
		return;
	}
	if ((wheel_heading_offset != cached_wheel_heading)) {
		mat_rot_y((&(wheel_heading_rotation)),
				  TempleCastS16(TempleCastS32((-(wheel_heading_offset)))));
		(cached_wheel_heading = TempleCastS16(wheel_heading_offset));
	}
	mat_mul_vector((&(wheel_forward_travel)), (&(wheel_heading_rotation)),
				   (&(temple_plane_direction_431)));
	mat_mul_vector((&(temple_plane_direction_431)), (&(car_to_world_rotation)),
				   (&(wheel_world_travel)));
}
