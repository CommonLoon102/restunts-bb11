legacy_void locate_many_resources(legacy_s8 *data, legacy_s8 *names, legacy_s8 **result)
{
	while (1) {
		if (!(((*(names)) != 0))) {
			break;
		}
		((*(result)) = locate_shape_fatal(data, names));
		(names += 4);
		(result++);
	}
}

