		if ((temple_chunk_537 == mmgr_live_sentinel)) {
			fatal_error("memory manager - BLOCK NOT FOUND at SEG= %x", temple_segment_536);
		}
		if ((temple_chunk_537->resofs == temple_segment_536)) {
			break;
