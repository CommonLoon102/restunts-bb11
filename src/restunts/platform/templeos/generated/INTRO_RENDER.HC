			TempleCastU16(TempleCastU16(TempleCastU16(timer_get_delta())))));
		rs_intro_render_intro_advance_session((&(temple_intro_5388)),
											  TempleCastS16(temple_delta_5391));
		if ((temple_intro_5388.needs_render != 0)) {
			rs_intro_render_intro_capture_view((&(temple_intro_5388)), (&(temple_view_5392)));
			rs_intro_render_intro_render_session((&(temple_intro_5388)), (&(temple_view_5392)));
		}
