		temple_elapsed_limit_5395 =
			TempleCastS16(rs_intro_render_legacy_s16_from_bits(TempleCastU16(TempleCastU16(
				TempleCastU16(TempleCastU32((TempleCastU32(TempleCastU16(23)) *
