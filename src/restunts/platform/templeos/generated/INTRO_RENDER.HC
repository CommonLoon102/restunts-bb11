legacy_void rs_intro_render_intro_present_session(INTRO_SESSION *intro)
{
	RECTANGLE temple_redraw_rect_5383;
	legacy_u16 *temple_tmp_5384;
	if ((video_uses_page_flipping != 0)) {
		mouse_draw_opaque_check();
		sprite_present_mcga_backbuffer();
		mouse_draw_transparent_check();
		if ((slow_video_mgmt_copy != 0)) {
			MemCpy(&(frame_layer_rects[intro->rect_index]), &(intro->shape_rect),
				   sizeof(RECTANGLE));
		}
		temple_tmp_5384 = &(intro->rect_index);
		((*temple_tmp_5384) = TempleCastU16(((*temple_tmp_5384) ^ 1)));
	} else {
		sprite_select_screen_compat();
		if ((slow_video_mgmt_copy != 0)) {
			rect_union((&(intro->combined_rect)), (&(frame_layer_rects[2])),
					   (&(temple_redraw_rect_5383)));
			if ((rect_intersect((&(temple_redraw_rect_5383)), (&(intro_redraw_cliprect))) == 0)) {
				sprite_set_target_clip_bounds(TempleCastU16(temple_redraw_rect_5383.left),
											  TempleCastU16(temple_redraw_rect_5383.right),
											  TempleCastU16(temple_redraw_rect_5383.top),
											  TempleCastU16(temple_redraw_rect_5383.bottom));
				mouse_draw_opaque_check();
				sprite_putimage(render_window_sprite->sprite_bitmapptr);
				mouse_draw_transparent_check();
				MemCpy(&(frame_layer_rects[0]), &(intro->shape_rect), sizeof(RECTANGLE));
				MemCpy(&(frame_layer_rects[2]), &(intro->combined_rect), sizeof(RECTANGLE));
			}
		} else {
			mouse_draw_opaque_check();
			sprite_putimage(render_window_sprite->sprite_bitmapptr);
			mouse_draw_transparent_check();
		}
	}
}

