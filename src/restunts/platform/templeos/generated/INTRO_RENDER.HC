		(temple_key_5393 = TempleCastS16(input_do_checking(TempleCastS16(temple_delta_5391))));
		temple_tmp_5394 = !!((temple_key_5393 == KEY_F11));
		if (!temple_tmp_5394) {
			temple_tmp_5394 = !!((temple_key_5393 == KEY_F12));
		}
		if (temple_tmp_5394) {
			handle_ingame_kb_shortcuts(TempleCastS16(temple_key_5393));
			rs_intro_render_intro_request_full_redraw((&(temple_intro_5388)));
			(temple_key_5393 = TempleCastS16(0));
		}
		if ((temple_key_5393 != 0)) {
			(temple_interrupted_5389 = TempleCastS8(1));
			break;
