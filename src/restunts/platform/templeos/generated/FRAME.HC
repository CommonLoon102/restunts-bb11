            temple_tmp_5009=!!(
                (TempleCastU32((currenttransshape[temple_shape_index_5007].ts_flags&16))==0));
            if(temple_tmp_5009) {
              temple_tmp_5009=!!((
                  rs_frame_frame_state->opponentstate.car_crash_bmp_flag==CRASH_EVENT_COLLISION));
            }
