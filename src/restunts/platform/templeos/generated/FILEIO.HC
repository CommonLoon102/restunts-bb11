		case 4:
			return load_song_file(filename);
		case 5:
			return load_voice_file(filename);
		case 6:
			return load_sfx_file(filename);
		case 7:
			return file_decomp_nofatal(filename);
		case 8:
			return file_load_shape2d_nofatal2(filename);
	}
	return 0;
}

