				rs_replay_viewer_replay_controls_draw(TempleCastU16(state.game_frame),
													  TempleCastU16(state.game_frame));
			}
			return;
		}
		rs_replay_viewer_replay_refresh_playback_controls();
		if ((rs_replay_viewer_replay_handle_camera_input((&(temple_input_1841))) != 0)) {
			return;
		}
		if ((rs_replay_viewer_replay_handle_control_input(TempleCastU16(temple_input_1841)) != 0)) {
			return;
		}
		temple_tmp_1847 = !!((is_in_replay != 0));
		if (temple_tmp_1847) {
			temple_tmp_1847 = !!((frame_fps_expire_idle() != 0));
		}
		if (temple_tmp_1847) {
			return;
		}
		rs_replay_viewer_replay_controls_draw(TempleCastU16(state.game_frame),
											  TempleCastU16(state.game_frame));
	}
}

legacy_void loop_game(legacy_s16 operation, legacy_s16 recorded_frame, legacy_s16 current_frame)
{
	if ((operation == REPLAY_LOOP_LOAD_RESOURCES)) {
		locate_many_resources((sdgameresptr)(legacy_s8 *), replay_control_shape_ids,
							  (rplyshapes)(legacy_s8 **));
		rs_replay_viewer_replay_controls_select(TempleCastU8(REPLAY_CONTROL_PAUSE));
		return;
	}
	if ((operation == REPLAY_LOOP_DRAW_CONTROLS)) {
		rs_replay_viewer_replay_controls_draw(TempleCastU16(recorded_frame),
											  TempleCastU16(current_frame));
		return;
	}
	if ((operation == REPLAY_LOOP_SELECT_CONTROL)) {
		rs_replay_viewer_replay_controls_select(TempleCastU8(TempleCastU8(recorded_frame)));
		return;
	}
	if ((operation != REPLAY_LOOP_HANDLE_INPUT)) {
		return;
	}
	rs_replay_viewer_replay_handle_input();
}
