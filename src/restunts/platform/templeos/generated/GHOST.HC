		(rs_ghost_ghost_pose.camera.crash_frame = TempleCastS16(state.game_pEndFrame));
		if ((dos_file_write(TempleCastU16(rs_ghost_ghost_file), (&(rs_ghost_ghost_pose)),
							TempleCastU16(sizeof(GHOST_POSE))) != sizeof(GHOST_POSE))) {
