	if (temple_tmp_2023) {
		return TempleCastS16(0);
	}
	temple_tmp_2024 = !!((!(rs_ghost_ghost_seek(TempleCastU16(rs_ghost_ghost_file),
												TempleCastS32(TempleCastU32((26 + 1802)))))));
	if (!temple_tmp_2024) {
